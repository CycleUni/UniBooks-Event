---
import '../styles/global.css';
import { useTranslations, eventPath, translations } from '../i18n/utils';
import { DEFAULT_LANG } from '../i18n/config';

interface Props {
  /** The page's name as a translation key: the tab title follows the language picked on the page. */
  titleKey?: string;
  description?: string;
  fullscreen?: boolean;
}

const { titleKey, fullscreen = false } = Astro.props;
const t = useTranslations(DEFAULT_LANG);

const pageTitle = titleKey ? `${t(titleKey)} | ${t('common.appName')}` : t('common.appName');
const serializedI18n = JSON.stringify(translations);

// The region in a public page's path; elsewhere the script below fills the link in.
const pathRegion = Astro.url.pathname.match(/^\/event\/([a-z]{2})(?:\/|$)/)?.[1] ?? 'tw';
const eventsNavPath = eventPath(`/${pathRegion}`);
// The public pages: /event and /event/<region>/...
const onEventList = /^\/event(?:\/?$|\/[a-z]{2}(?:\/|$))/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="zh-TW" data-title-key={titleKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/event/icons/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ serializedI18n }}>
      (function() {
        // Theme preference restoration
        try {
          var storedTheme = localStorage.getItem('unibooks_theme');
          if (storedTheme === 'dark' || storedTheme === 'light') {
            document.documentElement.setAttribute('data-theme', storedTheme);
          }
        } catch (e) {}

        // Global Client i18n
        try {
          window.__UB_I18N_DICTS = JSON.parse(serializedI18n);
        } catch (e) {
          window.__UB_I18N_DICTS = {};
        }

        // A region's default language; public/prefs.js fills it from the main site's regions.
        window.__regionDefaultLang = { tw: 'zh-TW', hk: 'zh-HK' };

        /** The region: a public page's path, else the main site's stored choice, else a timezone guess. */
        window.__getRegion = function() {
          var match = location.pathname.match(/^\/event\/([a-z]{2})(?:\/|$)/);
          if (match) return match[1];
          try {
            var stored = (localStorage.getItem('region') || '').toLowerCase();
            if (/^[a-z]{2}$/.test(stored)) return stored;
          } catch (e) {}
          try {
            if (Intl.DateTimeFormat().resolvedOptions().timeZone === 'Asia/Hong_Kong') return 'hk';
          } catch (e) {}
          return 'tw';
        };

        /** The language: the stored choice, else the region's default. */
        window.__getLang = function() {
          try {
            var stored = localStorage.getItem('lang');
            if (stored === 'zh-TW' || stored === 'zh-HK' || stored === 'en') return stored;
          } catch (e) {}
          return window.__regionDefaultLang[window.__getRegion()] || 'zh-TW';
        };

        window.__t = function(key, params) {
          var lang = window.__getLang();
          var dict = (window.__UB_I18N_DICTS && window.__UB_I18N_DICTS[lang]) || (window.__UB_I18N_DICTS && window.__UB_I18N_DICTS['zh-TW']) || {};
          var str = dict[key] || (window.__UB_I18N_DICTS['zh-TW'] && window.__UB_I18N_DICTS['zh-TW'][key]) || key;
          if (params) {
            for (var k in params) {
              str = str.replace(new RegExp('\\{' + k + '\\}', 'g'), String(params[k]));
            }
          }
          return str;
        };

        window.__applyTranslations = function() {
          var lang = window.__getLang();
          document.documentElement.lang = lang;

          // The tab title too: it is rendered in the default language before the visitor's is known.
          var titleKey = document.documentElement.getAttribute('data-title-key');
          document.title = (titleKey ? window.__t(titleKey) + ' | ' : '') + window.__t('common.appName');

          document.querySelectorAll('[data-i18n]').forEach(function(el) {
            var key = el.getAttribute('data-i18n');
            if (key) el.textContent = window.__t(key);
          });

          document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
            var key = el.getAttribute('data-i18n-placeholder');
            if (key) el.placeholder = window.__t(key);
          });

          document.querySelectorAll('[data-i18n-aria-label]').forEach(function(el) {
            var key = el.getAttribute('data-i18n-aria-label');
            if (key) {
              var txt = window.__t(key);
              el.setAttribute('aria-label', txt);
              el.title = txt;
            }
          });

          var currentReg = window.__getRegion();
          var navEvents = document.getElementById('nav-events-link');
          if (navEvents) navEvents.href = '/event/' + currentReg;
        };

        try {
          document.documentElement.lang = window.__getLang();
        } catch (e) {}
      })();
    </script>
    <script is:inline src="/event/session.js"></script>
    <script is:inline src="/event/prefs.js"></script>
    <script is:inline src="/event/upload.js"></script>
  </head>
  <body class={fullscreen ? 'body-fullscreen' : ''}>
    {!fullscreen && (
      <header class="app-header">
        <div class="container header-content">
          <div class="brand-area">
            <div class="logo">
              <a href={eventPath('/')}>
                <img class="logo-mark logo-mark-light" src="/event/icons/logo-mark.svg" alt="UniBooks" width="28" height="28" />
                <img class="logo-mark logo-mark-dark" src="/event/icons/logo-mark-dark.svg" alt="UniBooks" width="28" height="28" />
                <span class="logo-name">UniBooks</span>
                <span class="brand-badge">Event</span>
              </a>
            </div>
          </div>

          <div class="header-right">
            <nav class="nav-links">
              <a
                id="nav-events-link"
                href={eventsNavPath}
                class:list={[{ 'active-link': onEventList }]}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span data-i18n="event.listTitle">{t('event.listTitle')}</span>
              </a>

              <!-- Sign-in until someone is; then the account menu below takes its place. -->
              <a id="nav-account-link" href="/login" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                  <circle cx="12" cy="8" r="3.5"/>
                  <path d="M5 20c0-3.87 3.13-7 7-7s7 3.13 7 7"/>
                </svg>
                <span id="nav-account-label" data-i18n="nav.login">{t('nav.login')}</span>
              </a>

            </nav>

            <!-- Signed in: the member's name opens their menu, the main site's account
                 page and, for staff, this system's admin. Outside <nav>, whose link
                 styles are not for menu items. -->
            <div class="dropdown-wrapper account-menu" id="account-dropdown" style="display: none;">
              <button
                type="button"
                class="dropdown-trigger-btn account-trigger"
                id="account-trigger"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="account-panel"
              >
                <span id="account-name"></span>
                <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="12" height="12" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <div class="dropdown-panel" id="account-panel">
                <ul class="dropdown-list">
                  <li><a class="dropdown-item" id="account-page-link" href="/"><span data-i18n="nav.myAccount">{t('nav.myAccount')}</span></a></li>
                  <li id="account-admin-item" hidden><a class="dropdown-item" href={eventPath('/admin/')}><span data-i18n="nav.admin">{t('nav.admin')}</span></a></li>
                </ul>
              </div>
            </div>
            <script is:inline>
              async function showAccount() {
                var account = document.getElementById('nav-account-link');
                var menu = document.getElementById('account-dropdown');
                if (!account || !menu || !window.__eventWho) return;
                var who = await window.__eventWho();
                var region = window.__getRegion ? window.__getRegion() : 'tw';
                if (who.user) {
                  // The name is the member's own, so no translation key.
                  document.getElementById('account-name').textContent = who.user.name || (window.__t ? window.__t('nav.account') : '');
                  document.getElementById('account-page-link').href = '/' + region + '/account';
                  document.getElementById('account-admin-item').hidden = !who.user.isStaff;
                  document.getElementById('account-trigger').classList.toggle('active-link', location.pathname.indexOf('/event/admin') === 0);
                  account.hidden = true;
                  menu.style.display = '';
                } else {
                  account.href = '/login?returnUrl=' + encodeURIComponent(location.pathname + location.search);
                  account.hidden = false;
                  menu.style.display = 'none';
                }
              }
              showAccount();
              // A renewed session (public/session.js) replaces the first answer.
              window.addEventListener('ub-session-changed', showAccount);
            </script>

            <!-- Theme Dropdown -->
            <div class="dropdown-wrapper" id="theme-dropdown">
              <button
                type="button"
                class="dropdown-trigger-btn"
                id="theme-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label={t('nav.themeSwitcher')}
                title={t('nav.themeSwitcher')}
              >
                <span class="theme-icon-wrap" aria-hidden="true">
                  <svg class="theme-sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4.5"/>
                    <path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12H5M19 12h2.5M4.2 19.8 6 18M18 6l1.8-1.8"/>
                  </svg>
                  <svg class="theme-moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
                  </svg>
                </span>
                <svg class="dropdown-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="12" height="12">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <div class="dropdown-panel" id="theme-panel">
                <ul class="dropdown-list" role="listbox">
                  <li>
                    <button type="button" class="dropdown-item" data-mode="system">
                      <span data-i18n="nav.themeSystem">{t('nav.themeSystem')}</span>
                      <svg class="dropdown-check check-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="display: none;">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </button>
                  </li>
                  <li>
                    <button type="button" class="dropdown-item" data-mode="light">
                      <span data-i18n="nav.themeLight">{t('nav.themeLight')}</span>
                      <svg class="dropdown-check check-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="display: none;">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </button>
                  </li>
                  <li>
                    <button type="button" class="dropdown-item" data-mode="dark">
                      <span data-i18n="nav.themeDark">{t('nav.themeDark')}</span>
                      <svg class="dropdown-check check-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="display: none;">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </button>
                  </li>
                </ul>
              </div>
            </div>

            <a href="/" class="btn btn-ghost btn-sm back-to-main" style="gap: 4px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              <span class="back-to-main-label" data-i18n="common.backToMain">{t('common.backToMain')}</span>
            </a>
          </div>
        </div>
      </header>
    )}

    <main
      class={fullscreen ? 'fullscreen-main' : 'container'}
      style={fullscreen ? 'padding: 0; flex: 1; display: flex; flex-direction: column; overflow: hidden; width: 100vw; height: 100vh; max-width: none;' : 'padding-top: var(--space-6); padding-bottom: var(--space-8); flex: 1;'}
    >
      <slot />
    </main>

    {!fullscreen && (
      <footer class="app-footer container">
        <div class="footer-content">
          <div class="footer-brand-area">
            <span class="footer-brand">UniBooks</span>
            <span class="footer-tagline" data-i18n="footer.tagline">{t('footer.tagline')}</span>
          </div>
          <div class="footer-links">
            <a href="/about" target="_blank" rel="noopener noreferrer" data-i18n="footer.about">{t('footer.about')}</a>
            <a href="/terms" target="_blank" rel="noopener noreferrer" data-i18n="footer.terms">{t('footer.terms')}</a>
            <a href="/privacy" target="_blank" rel="noopener noreferrer" data-i18n="footer.privacy">{t('footer.privacy')}</a>
          </div>

          <!-- Region and language menus, as on the main site: public/prefs.js. -->
          <div class="footer-prefs" id="footer-prefs" role="group"></div>
        </div>
      </footer>
    )}

    <script is:inline>
      (function() {
        const themeTrigger = document.getElementById('theme-trigger');
        const themePanel = document.getElementById('theme-panel');

        function closeAllDropdowns() {
          document.querySelectorAll('.dropdown-panel.is-open').forEach(function(panel) { panel.classList.remove('is-open'); });
          document.querySelectorAll('.dropdown-trigger-btn[aria-expanded="true"]').forEach(function(btn) { btn.setAttribute('aria-expanded', 'false'); });
        }

        const accountTrigger = document.getElementById('account-trigger');
        const accountPanel = document.getElementById('account-panel');
        if (accountTrigger && accountPanel) {
          accountTrigger.addEventListener('click', function(e) {
            e.stopPropagation();
            const isOpen = accountPanel.classList.contains('is-open');
            closeAllDropdowns();
            if (!isOpen) {
              accountPanel.classList.add('is-open');
              accountTrigger.setAttribute('aria-expanded', 'true');
              accountPanel.querySelector('li:not([hidden]) a')?.focus();
            }
          });
        }

        if (themeTrigger && themePanel) {
          themeTrigger.addEventListener('click', function(e) {
            e.stopPropagation();
            const isOpen = themePanel.classList.contains('is-open');
            closeAllDropdowns();
            if (!isOpen) {
              themePanel.classList.add('is-open');
              themeTrigger.setAttribute('aria-expanded', 'true');
            }
          });
        }

        document.addEventListener('click', function(e) {
          if (!e.target.closest('.dropdown-wrapper')) {
            closeAllDropdowns();
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            const openPanel = document.querySelector('.dropdown-panel.is-open');
            const trigger = openPanel ? openPanel.closest('.dropdown-wrapper')?.querySelector('.dropdown-trigger-btn') : null;
            closeAllDropdowns();
            if (trigger) trigger.focus();
          }
        });

        // Theme Mode Logic (system, light, dark)
        const sunIcon = document.querySelector('.theme-sun-icon');
        const moonIcon = document.querySelector('.theme-moon-icon');
        const checkSystem = document.querySelector('.check-system');
        const checkLight = document.querySelector('.check-light');
        const checkDark = document.querySelector('.check-dark');
        const themeItems = document.querySelectorAll('#theme-panel .dropdown-item');

        function getStoredMode() {
          try {
            const val = localStorage.getItem('unibooks_theme');
            return val === 'light' || val === 'dark' ? val : 'system';
          } catch(e) {
            return 'system';
          }
        }

        function resolveEffectiveDark(mode) {
          if (mode === 'dark') return true;
          if (mode === 'light') return false;
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        function applyFavicon(isDark) {
          try {
            const link = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
            if (!link) return;
            const href = isDark ? '/event/icons/favicon-dark.svg' : '/event/icons/favicon.svg';
            if (link.getAttribute('href') !== href) link.setAttribute('href', href);
          } catch (e) {}
        }

        function updateThemeUI() {
          const mode = getStoredMode();
          const isDark = resolveEffectiveDark(mode);

          if (sunIcon && moonIcon) {
            sunIcon.style.display = isDark ? 'none' : 'block';
            moonIcon.style.display = isDark ? 'block' : 'none';
          }

          applyFavicon(isDark);

          themeItems.forEach(function(item) {
            const itemMode = item.getAttribute('data-mode');
            item.classList.toggle('active', itemMode === mode);
          });

          if (checkSystem) checkSystem.style.display = mode === 'system' ? 'block' : 'none';
          if (checkLight) checkLight.style.display = mode === 'light' ? 'block' : 'none';
          if (checkDark) checkDark.style.display = mode === 'dark' ? 'block' : 'none';
        }

        function setThemeMode(mode) {
          try {
            if (mode === 'system') {
              localStorage.removeItem('unibooks_theme');
              document.documentElement.removeAttribute('data-theme');
            } else {
              localStorage.setItem('unibooks_theme', mode);
              document.documentElement.setAttribute('data-theme', mode);
            }
          } catch(e) {}
          updateThemeUI();
          closeAllDropdowns();
        }

        themeItems.forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const mode = this.getAttribute('data-mode');
            setThemeMode(mode);
          });
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
          if (getStoredMode() === 'system') {
            updateThemeUI();
          }
        });

        updateThemeUI();
        if (window.__applyTranslations) {
          window.__applyTranslations();
        }
      })();
    </script>
  </body>
</html>
