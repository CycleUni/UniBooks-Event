---
import { useTranslations, eventPath } from '../i18n/utils';
import { DEFAULT_LANG } from '../i18n/config';

/**
 * The back office's sections, as tabs at the top of every admin page. Each
 * person sees only theirs (src/scripts/admin-tabs.ts): staff the draws and
 * the student organizations, an organization's admins its book drives.
 */
interface Props {
  active: 'draws' | 'drives' | 'orgs';
}
const { active } = Astro.props;
const t = useTranslations(DEFAULT_LANG);
const tabs = [
  { id: 'draws', href: eventPath('/admin/'), key: 'adminTabs.draws', who: 'staff' },
  { id: 'drives', href: eventPath('/admin/drives/'), key: 'adminTabs.drives', who: 'drives' },
  { id: 'orgs', href: eventPath('/admin/orgs/'), key: 'adminTabs.orgs', who: 'staff' },
];
---

<nav class="admin-tabs" aria-label={t('adminTabs.label')} data-i18n-aria-label="adminTabs.label">
  {tabs.map((tab) => (
    <a href={tab.href} class:list={['admin-tab', { active: tab.id === active }]} aria-current={tab.id === active ? 'page' : undefined} data-tab-who={tab.who} hidden>
      <span data-i18n={tab.key}>{t(tab.key)}</span>
    </a>
  ))}
</nav>
