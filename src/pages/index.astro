---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRegions, type Region } from '../lib/regions';

// Rendered on request: the regions come from the main site's database. The page shows nothing; it only sends the visitor to their region.
export const prerender = false;

const env = Astro.locals.runtime?.env;
const regions: Region[] = env ? await getRegions(env, Astro.request).catch(() => []) : [];
const codes = regions.map((r) => r.code.toLowerCase());
---

<BaseLayout>
  <script is:inline define:vars={{ codes }}>
    // The region, picked as the main site picks it: a signed-in member's
    // account region (as the main site's home does on sign-in), else the saved
    // choice (shared with the main site), else a Taipei or Hong Kong timezone,
    // else where the main site's /core/geo places the visitor's IP, waiting at
    // most 800 ms as the main site does. A detected region is saved for both sites.
    function go(region) {
      location.replace('/event/' + (codes.length === 0 || codes.indexOf(region) >= 0 ? region : codes[0]));
    }
    function pick() {
    var stored = null;
    try { stored = localStorage.getItem('region'); } catch (e) {}
    var zone = '';
    try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (e) {}
    if (stored || zone === 'Asia/Taipei' || zone === 'Asia/Hong_Kong') {
      go(window.__getRegion());
    } else {
      var done = false;
      var finish = function (code) {
        if (done) return;
        done = true;
        if (code) {
          try { localStorage.setItem('region', code); } catch (e) {}
        }
        go(code || window.__getRegion());
      };
      setTimeout(function () { finish(null); }, 800);
      // The main site's backend first, taken as given; else the country in
      // /cdn-cgi/trace, which must be a known region.
      var backend = fetch('/api/v1/core/geo', { credentials: 'omit', cache: 'no-store' })
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (body) { return body && typeof body.region === 'string' ? body.region.toLowerCase() : ''; })
        .catch(function () { return ''; });
      var trace = fetch('/cdn-cgi/trace', { credentials: 'omit', cache: 'no-store' })
        .then(function (res) { return res.ok ? res.text() : ''; })
        .then(function (text) { var m = /^loc=([A-Za-z]{2})\s*$/m.exec(text); return m ? m[1].toLowerCase() : ''; })
        .catch(function () { return ''; });
      backend.then(function (code) {
        if (/^[a-z]{2}$/.test(code)) return code;
        return trace.then(function (c) { return codes.indexOf(c) >= 0 ? c : ''; });
      }).then(function (code) { finish(code || null); });
    }
    }

    // Only someone the main site says is signed in (its ub_session hint) waits on who they are.
    if (/(?:^|;\s*)ub_session=1(?:;|$)/.test(document.cookie) && window.__eventWho) {
      var settled = false;
      var fallback = setTimeout(function () { settled = true; pick(); }, 800);
      window.__eventWho().then(function (who) {
        if (settled) return;
        settled = true;
        clearTimeout(fallback);
        var saved = who.user && who.user.siteRegion;
        if (saved && codes.indexOf(saved) >= 0) {
          try { localStorage.setItem('region', saved); } catch (e) {}
          go(saved);
        } else {
          pick();
        }
      });
    } else {
      pick();
    }
  </script>

  <noscript><meta http-equiv="refresh" content="0; url=/event/tw" /></noscript>
</BaseLayout>
