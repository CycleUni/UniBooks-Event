---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminTabs from '../../../components/AdminTabs.astro';
import ConfirmDialog from '../../../components/ConfirmDialog.astro';
import { useTranslations, eventPath } from '../../../i18n/utils';
import { DEFAULT_LANG } from '../../../i18n/config';

const t = useTranslations(DEFAULT_LANG);
---

<!--
  Student organizations, for staff (後台管理 › 學生組織): a compact list of
  the region chosen in the footer; a row opens to its admins, what it may use
  in this system (its own draws, book drives) and its status. New ones are
  made in a dialog.
-->
<BaseLayout titleKey="adminTabs.orgs">
  <div id="orgs-loading" class="page-loading" role="status" aria-live="polite">
    <span class="page-loading-spinner" aria-hidden="true"></span>
    <span data-i18n="common.loading">{t('common.loading')}</span>
  </div>

  <div id="orgs-staff-only" class="card" style="display: none; max-width: 520px; margin: 3rem auto; text-align: center; padding: var(--space-7) var(--space-5);">
    <h1 data-i18n="admin.staffOnlyTitle" style="font-size: var(--text-2xl); font-weight: 700; color: var(--flag); margin-bottom: var(--space-2);">{t('admin.staffOnlyTitle')}</h1>
    <p data-i18n="admin.staffOnlyPrompt" style="color: var(--muted); margin-bottom: var(--space-5); line-height: 1.5;">{t('admin.staffOnlyPrompt')}</p>
    <a href={eventPath('/')} class="btn btn-secondary" data-i18n="common.backToMain">{t('common.backToMain')}</a>
  </div>

  <div id="orgs-view" style="display: none;">
    <AdminTabs active="orgs" />
    <div class="page-head">
      <div>
        <h1 data-i18n="adminTabs.orgs">{t('adminTabs.orgs')}</h1>
        <p class="page-head-sub" data-i18n="orgAdmin.intro">{t('orgAdmin.intro')}</p>
      </div>
      <div class="page-actions">
        <button type="button" id="org-new-btn" class="btn btn-primary" data-i18n="orgAdmin.create">{t('orgAdmin.create')}</button>
      </div>
    </div>

    <div id="orgs-no-regions" class="card" style="display: none; text-align: center; padding: var(--space-7);">
      <p data-i18n="admin.noManagedRegions" style="color: var(--muted); margin: 0;">{t('admin.noManagedRegions')}</p>
    </div>

    <div id="orgs-main">
      <form id="orgs-search" role="search" style="display: flex; gap: var(--space-2); margin-bottom: var(--space-4);">
        <input id="orgs-q" type="search" class="form-input" style="flex: 1; min-width: 0;" placeholder={t('orgAdmin.search')} data-i18n-placeholder="orgAdmin.search" aria-label={t('orgAdmin.search')} />
        <button type="submit" class="btn btn-secondary" style="white-space: nowrap;" data-i18n="org.search">{t('org.search')}</button>
      </form>

      <p id="orgs-error" role="alert" style="display: none; color: var(--flag); margin-bottom: var(--space-3);"></p>
      <div id="orgs-empty" class="card" style="display: none; text-align: center; padding: var(--space-7) var(--space-5);">
        <p id="orgs-empty-text" style="color: var(--muted);"></p>
      </div>
      <ul id="orgs-list" class="list-rows" style="display: none;"></ul>

      <div id="orgs-pager" style="display: none; gap: var(--space-3); align-items: center; justify-content: center; margin-top: var(--space-4);">
        <button type="button" id="orgs-prev" class="btn btn-secondary btn-sm" data-i18n="org.prevPage">{t('org.prevPage')}</button>
        <span id="orgs-page" style="color: var(--muted); font-size: var(--text-sm);"></span>
        <button type="button" id="orgs-next" class="btn btn-secondary btn-sm" data-i18n="org.nextPage">{t('org.nextPage')}</button>
      </div>
    </div>
  </div>

  <!-- New organization -->
  <div id="org-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="org-modal-title">
    <form id="org-create" class="card modal-card" novalidate>
      <h2 id="org-modal-title" class="modal-title" data-i18n="orgAdmin.create">{t('orgAdmin.create')}</h2>
      <p id="org-modal-region" style="color: var(--muted); font-size: var(--text-sm); margin-bottom: var(--space-4);"></p>
      <div class="form-group">
        <label class="form-label" for="org-school" data-i18n="orgAdmin.school">{t('orgAdmin.school')}</label>
        <select id="org-school" class="form-select" required></select>
      </div>
      <div class="form-group">
        <label class="form-label" for="org-name" data-i18n="orgAdmin.name">{t('orgAdmin.name')}</label>
        <input id="org-name" class="form-input" maxlength="50" required placeholder={t('orgAdmin.namePlaceholder')} data-i18n-placeholder="orgAdmin.namePlaceholder" />
        <p data-i18n="orgAdmin.nameHint" style="color: var(--muted); font-size: var(--text-xs); margin-top: 4px;">{t('orgAdmin.nameHint')}</p>
      </div>
      <fieldset class="form-group" style="border: 0; padding: 0; margin-inline: 0;">
        <legend class="form-label" data-i18n="orgAdmin.features">{t('orgAdmin.features')}</legend>
        <label class="check-label"><input type="checkbox" id="org-feature-draws" class="form-checkbox" /> <span data-i18n="orgAdmin.featureDraws">{t('orgAdmin.featureDraws')}</span></label>
        <label class="check-label"><input type="checkbox" id="org-feature-drives" class="form-checkbox" checked /> <span data-i18n="orgAdmin.featureDrives">{t('orgAdmin.featureDrives')}</span></label>
      </fieldset>
      <p id="org-create-error" role="alert" style="display: none; color: var(--flag); font-size: var(--text-sm);"></p>
      <div class="modal-actions">
        <button type="button" id="org-cancel" class="btn btn-secondary" data-i18n="common.cancel">{t('common.cancel')}</button>
        <button type="submit" id="org-create-btn" class="btn btn-primary" data-i18n="orgAdmin.createButton">{t('orgAdmin.createButton')}</button>
      </div>
    </form>
  </div>

  <ConfirmDialog />

  <style is:global>
    .org-row-side {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      flex: none;
    }
    .org-row-chevron {
      color: var(--muted);
      transition: transform var(--motion-fast, 0.15s) ease;
    }
    .list-row[aria-expanded='true'] .org-row-chevron {
      transform: rotate(180deg);
    }
    .org-detail-foot {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--line);
      padding-top: var(--space-3);
      color: var(--muted);
      font-size: var(--text-sm);
    }
  </style>

  <script>
    import { mainApi, apiErrorText } from '../../../scripts/main-api';
    import { regionMetadata } from '../../../scripts/region-metadata';
    import { confirmAction, isConfirmOpen } from '../../../scripts/confirm';
    import { personChips, addPersonForm } from '../../../scripts/people';
    import { backOfficeHome, hasBackOffice, showAdminTabs } from '../../../scripts/admin-tabs';

    type Feature = 'draws' | 'drives';
    const FEATURES: Feature[] = ['draws', 'drives'];
    const featureKey = (f: Feature) => (f === 'draws' ? 'orgAdmin.featureDraws' : 'orgAdmin.featureDrives');

    interface Org {
      id: string;
      region: string;
      display_name: string;
      school: { id: number; code: string; name: string } | null;
      is_active: boolean;
      features: Record<Feature, boolean>;
      admins: { id: string; email: string; display_name: string }[];
      member_count: number;
    }

    const PAGE_SIZE = 20;
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const show = (id: string, on: boolean, display = 'block') => ($(id).style.display = on ? display : 'none');

    let page = 1;
    let total = 0;
    let query = '';
    let managedRegions: string[] | null = null;
    /** The row left open, kept open when the list is redrawn. */
    let openId: string | null = null;

    const region = () => window.__getRegion().toUpperCase();

    // --- New organization --------------------------------------------------
    let modalTrigger: HTMLElement | null = null;

    async function openCreate() {
      modalTrigger = document.activeElement as HTMLElement | null;
      show('org-create-error', false);
      $<HTMLInputElement>('org-name').value = '';
      $<HTMLInputElement>('org-feature-draws').checked = false;
      $<HTMLInputElement>('org-feature-drives').checked = true;
      const meta = await regionMetadata(region());
      $<HTMLSelectElement>('org-school').replaceChildren(
        new Option(window.__t('orgAdmin.pickSchool'), ''),
        ...(meta.schools ?? []).map((s) => new Option(`${s.display_name} (${s.code})`, String(s.id))),
      );
      const regionName = window.__regionName(await window.__eventRegions(), region());
      $('org-modal-region').textContent = window.__t('orgAdmin.inRegion', { region: regionName });
      $('org-modal').classList.add('open');
      $('org-school').focus();
    }

    function closeCreate() {
      $('org-modal').classList.remove('open');
      modalTrigger?.focus?.();
    }

    $('org-new-btn').addEventListener('click', openCreate);
    $('org-cancel').addEventListener('click', closeCreate);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !isConfirmOpen() && $('org-modal').classList.contains('open')) closeCreate();
    });

    $('org-create').addEventListener('submit', async (e) => {
      e.preventDefault();
      show('org-create-error', false);
      const school = Number($<HTMLSelectElement>('org-school').value);
      const name = $<HTMLInputElement>('org-name').value.trim();
      if (!school || !name) {
        $('org-create-error').textContent = window.__t(school ? 'orgAdmin.errNameRequired' : 'orgAdmin.errSchoolRequired');
        show('org-create-error', true);
        return;
      }
      const btn = $<HTMLButtonElement>('org-create-btn');
      btn.disabled = true;
      btn.textContent = window.__t('orgAdmin.creating');
      try {
        const features = Object.fromEntries(FEATURES.map((f) => [f, $<HTMLInputElement>(`org-feature-${f}`).checked]));
        const org = await mainApi<Org>('/admin/organizations', { body: { school, name, features } });
        closeCreate();
        page = 1;
        query = '';
        $<HTMLInputElement>('orgs-q').value = '';
        // Open the new one: adding its admins is the next thing to do.
        openId = org.id;
        await loadOrgs();
      } catch (err) {
        $('org-create-error').textContent = apiErrorText(err);
        show('org-create-error', true);
      } finally {
        btn.disabled = false;
        btn.textContent = window.__t('orgAdmin.createButton');
      }
    });

    // --- The list ----------------------------------------------------------
    async function loadOrgs() {
      show('orgs-error', false);
      try {
        const q = new URLSearchParams({ region: region(), page: String(page), page_size: String(PAGE_SIZE) });
        if (query) q.set('q', query);
        const res = await mainApi<{ count: number; results: Org[] }>(`/admin/organizations?${q}`);
        total = res.count;
        render(res.results);
      } catch (err) {
        $('orgs-error').textContent = apiErrorText(err);
        show('orgs-error', true);
      }
    }

    /** Run a change to one organization; its row is redrawn from the answer, still open. */
    async function change(li: HTMLElement, request: Promise<Org>): Promise<string | null> {
      li.querySelectorAll('button, input').forEach((x) => ((x as HTMLButtonElement).disabled = true));
      try {
        const org = await request;
        li.replaceWith(orgRow(org));
        return null;
      } catch (err) {
        li.querySelectorAll('button, input').forEach((x) => ((x as HTMLButtonElement).disabled = false));
        return apiErrorText(err);
      }
    }

    function orgRow(org: Org): HTMLElement {
      const li = document.createElement('li');
      const open = openId === org.id;

      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'list-row';
      row.setAttribute('aria-expanded', String(open));
      const main = document.createElement('span');
      const name = document.createElement('strong');
      name.style.display = 'block';
      name.textContent = org.display_name;
      const sub = document.createElement('span');
      sub.className = 'list-row-sub';
      sub.textContent = [
        org.school?.code,
        window.__t('orgAdmin.adminCount', { n: org.admins.length }),
        window.__t('org.memberCount', { n: org.member_count }),
        FEATURES.filter((f) => org.features[f])
          .map((f) => window.__t(featureKey(f)))
          .join('、') || window.__t('orgAdmin.noFeatures'),
      ]
        .filter(Boolean)
        .join(' · ');
      main.append(name, sub);
      const side = document.createElement('span');
      side.className = 'org-row-side';
      const badge = document.createElement('span');
      badge.className = org.is_active ? 'badge badge-success' : 'badge badge-neutral';
      badge.textContent = window.__t(org.is_active ? 'orgAdmin.active' : 'orgAdmin.inactive');
      const chevron = document.createElement('span');
      chevron.className = 'org-row-chevron';
      chevron.setAttribute('aria-hidden', 'true');
      chevron.textContent = '⌄';
      side.append(badge, chevron);
      row.append(main, side);

      const detail = document.createElement('div');
      detail.className = 'list-row-detail';
      detail.hidden = !open;
      row.addEventListener('click', () => {
        const nowOpen = detail.hidden;
        openId = nowOpen ? org.id : null;
        detail.hidden = !nowOpen;
        row.setAttribute('aria-expanded', String(nowOpen));
      });

      const label = document.createElement('p');
      label.className = 'form-label';
      label.textContent = window.__t('orgAdmin.admins');
      const chips = personChips(org.admins, window.__t('orgAdmin.noAdmins'), (a) =>
        confirmAction(
          window.__t('orgAdmin.removeAdminTitle'),
          window.__t('orgAdmin.removeAdminDesc', { name: a.display_name, org: org.display_name }),
          window.__t('orgAdmin.removeAdminButton'),
          () => change(li, mainApi<Org>(`/admin/organizations/${org.id}/admins/${a.id}`, { method: 'DELETE' })),
        ),
      );
      const add = addPersonForm(window.__t('orgAdmin.addAdmin'), (email) =>
        change(li, mainApi<Org>(`/admin/organizations/${org.id}/admins`, { body: { email } })),
      );

      // What it may use here: each switch saves at once.
      const featureLabel = document.createElement('p');
      featureLabel.className = 'form-label';
      featureLabel.style.marginTop = 'var(--space-3)';
      featureLabel.textContent = window.__t('orgAdmin.features');
      const featureBox = document.createElement('div');
      for (const f of FEATURES) {
        const box = document.createElement('label');
        box.className = 'check-label';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.className = 'form-checkbox';
        input.checked = org.features[f];
        input.addEventListener('change', async () => {
          const failure = await change(li, mainApi<Org>(`/admin/organizations/${org.id}`, { method: 'PATCH', body: { features: { [f]: input.checked } } }));
          if (failure) {
            input.checked = !input.checked;
            $('orgs-error').textContent = failure;
            show('orgs-error', true);
          }
        });
        const text = document.createElement('span');
        text.textContent = window.__t(featureKey(f));
        box.append(input, text);
        featureBox.append(box);
      }
      const featureHint = document.createElement('p');
      featureHint.style.color = 'var(--muted)';
      featureHint.style.fontSize = 'var(--text-xs)';
      featureHint.style.marginBottom = 'var(--space-3)';
      featureHint.textContent = window.__t('orgAdmin.featuresHint');

      const foot = document.createElement('div');
      foot.className = 'org-detail-foot';
      const status = document.createElement('span');
      status.textContent = window.__t(org.is_active ? 'orgAdmin.activeHint' : 'orgAdmin.inactiveHint');
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = org.is_active ? 'btn btn-danger btn-sm' : 'btn btn-secondary btn-sm';
      toggle.textContent = window.__t(org.is_active ? 'orgAdmin.deactivate' : 'orgAdmin.activate');
      toggle.addEventListener('click', async () => {
        const send = () => change(li, mainApi<Org>(`/admin/organizations/${org.id}`, { method: 'PATCH', body: { is_active: !org.is_active } }));
        if (org.is_active) {
          confirmAction(
            window.__t('orgAdmin.deactivateTitle'),
            window.__t('orgAdmin.deactivateDesc', { org: org.display_name }),
            window.__t('orgAdmin.deactivate'),
            send,
          );
          return;
        }
        const failure = await send();
        if (failure) {
          $('orgs-error').textContent = failure;
          show('orgs-error', true);
        }
      });
      foot.append(status, toggle);

      detail.append(label, chips, add, featureLabel, featureBox, featureHint, foot);
      li.append(row, detail);
      return li;
    }

    function render(orgs: Org[]) {
      $('orgs-list').replaceChildren(...orgs.map(orgRow));
      $('orgs-empty-text').textContent = window.__t(query ? 'orgAdmin.noMatches' : 'orgAdmin.empty');
      show('orgs-empty', !orgs.length);
      show('orgs-list', orgs.length > 0);
      const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      show('orgs-pager', pages > 1, 'flex');
      $('orgs-page').textContent = window.__t('org.pageOf', { page, pages });
      $<HTMLButtonElement>('orgs-prev').disabled = page <= 1;
      $<HTMLButtonElement>('orgs-next').disabled = page >= pages;
    }

    $('orgs-search').addEventListener('submit', (e) => {
      e.preventDefault();
      query = $<HTMLInputElement>('orgs-q').value.trim();
      page = 1;
      loadOrgs();
    });
    $('orgs-prev').addEventListener('click', () => {
      page--;
      loadOrgs();
    });
    $('orgs-next').addEventListener('click', () => {
      page++;
      loadOrgs();
    });

    // --- Start ------------------------------------------------------------
    /** Show the chosen region's organizations, or say it is not one of this staff member's. */
    async function showRegion() {
      const allowed = managedRegions === null || managedRegions.includes(region());
      show('orgs-no-regions', !allowed);
      show('orgs-main', allowed);
      $('org-new-btn').style.display = allowed ? '' : 'none';
      if (!allowed) return;
      page = 1;
      await loadOrgs();
    }

    async function init() {
      const session = await window.__eventSession();
      if (session.state !== 'ok') {
        show('orgs-loading', false);
        return;
      }
      const user = session.user as { isStaff: boolean; managedRegions: string[] | null; organizations?: unknown[] };
      if (!user.isStaff) {
        // An organization's admin has a back office too: its roster.
        if (hasBackOffice(user)) {
          location.replace(backOfficeHome(user));
          return;
        }
        show('orgs-loading', false);
        show('orgs-staff-only', true);
        return;
      }
      showAdminTabs(user);
      managedRegions = user.managedRegions;
      await showRegion();
      show('orgs-loading', false);
      show('orgs-view', true);
    }

    window.addEventListener('ub-region-changed', () => {
      if ($('orgs-view').style.display === 'block') showRegion();
    });
    window.addEventListener('ub-lang-changed', () => {
      if ($('orgs-view').style.display === 'block') loadOrgs();
    });

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  </script>
</BaseLayout>
