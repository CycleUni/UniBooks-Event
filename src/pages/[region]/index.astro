---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, eventPath } from '../../i18n/utils';
import { DEFAULT_LANG } from '../../i18n/config';
import { regionPage } from '../../lib/region-page';

// Rendered on request: the regions are the main site's, from its database.
export const prerender = false;

const page = await regionPage(Astro);
if (page instanceof Response) return page;
const { region, regionCode } = page;
const t = useTranslations(DEFAULT_LANG);
---

<!--
  A region's draws. Whoever runs draws here works from this page too: staff
  who manage the region, and the admins of a student organization staff
  opened draws to (for the draws it hosts). They also see their draws not yet
  public, each with its entrant count, scanner and settings, and start new ones.
-->

<BaseLayout titleKey="event.listTitle">
  <div style="text-align: center; margin-bottom: var(--space-7);">
    <h1 data-i18n="event.listTitle" style="font-size: var(--text-3xl); font-weight: 700; margin-bottom: var(--space-2); color: var(--ink);">
      {t('event.listTitle')}
    </h1>
    <p data-i18n="event.listSubtitle" style="color: var(--muted); font-size: var(--text-md); max-width: 600px; margin: 0 auto;">
      {t('event.listSubtitle')}
    </p>
    <a id="draw-new-btn" href={eventPath(`/${region}/new`)} class="btn btn-primary" style="display: none; margin-top: var(--space-4);">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span data-i18n="admin.createEvent">{t('admin.createEvent')}</span>
    </a>
  </div>

  <!-- Loading State -->
  <div id="events-loading" class="page-loading" role="status" aria-live="polite">
    <span class="page-loading-spinner" aria-hidden="true"></span>
    <span data-i18n="common.loading">{t('common.loading')}</span>
  </div>

  <!-- Empty State -->
  <div id="events-empty" class="card" style="display: none; text-align: center; padding: var(--space-8) var(--space-5);">
    <p data-i18n="event.noEvents" style="color: var(--muted); font-size: var(--text-lg);">{t('event.noEvents')}</p>
  </div>

  <!-- Event Grid Container -->
  <div id="events-grid" data-region-code={regionCode} data-detail-base-url={eventPath(`/${region}`)} style="display: none; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: var(--space-5);">
  </div>

  <script>
    import { formatEventDates } from '../../lib/event-dates';
    import { canManageDraw, drawOrgs, hostNames, startsDraws } from '../../scripts/draw-access';

    const gridEl = document.getElementById('events-grid');
    const regionCode = gridEl?.dataset.regionCode || window.__getRegion().toUpperCase();
    const detailBaseUrl = gridEl?.dataset.detailBaseUrl || `/event/${regionCode.toLowerCase()}`;
    let cachedEvents = null;
    // Who is looking (null when signed out): the draws they run show their tools.
    let viewer = null;
    // The organizations hosting draws here, by id.
    let hosts = {};

    try {
      localStorage.setItem('region', regionCode.toLowerCase());
    } catch (e) {}

    function renderEventGrid(eventsList) {
      const gridEl = document.getElementById('events-grid');
      const emptyEl = document.getElementById('events-empty');
      if (!gridEl) return;

      if (!Array.isArray(eventsList) || eventsList.length === 0) {
        gridEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'block';
        return;
      }

      const txtActive = window.__t('event.statusActive');
      const txtViewDetails = window.__t('event.viewDetails');

      gridEl.replaceChildren();

      eventsList.forEach((item) => {
        const card = document.createElement('article');
        card.className = 'card card-interactive';
        card.style.display = 'flex';
        card.style.flexDirection = 'column';
        card.style.height = '100%';

        if (item.coverImageUrl) {
          const coverWrapper = document.createElement('div');
          coverWrapper.style.height = '180px';
          coverWrapper.style.margin = 'calc(var(--card-pad) * -1) calc(var(--card-pad) * -1) var(--space-4)';
          coverWrapper.style.overflow = 'hidden';
          coverWrapper.style.borderTopLeftRadius = 'var(--radius-card)';
          coverWrapper.style.borderTopRightRadius = 'var(--radius-card)';

          const img = document.createElement('img');
          img.src = item.coverImageUrl;
          img.alt = item.title || '';
          img.style.width = '100%';
          img.style.height = '100%';
          img.style.objectFit = 'cover';
          coverWrapper.appendChild(img);
          card.appendChild(coverWrapper);
        }

        const badgeRow = document.createElement('div');
        badgeRow.style.display = 'flex';
        badgeRow.style.gap = 'var(--space-2)';
        badgeRow.style.marginBottom = 'var(--space-2)';
        badgeRow.style.flexWrap = 'wrap';

        const statusBadge = document.createElement('span');
        if (item.ended) {
          statusBadge.className = 'badge badge-neutral';
          statusBadge.textContent = window.__t('event.statusEnded');
        } else if (item.isActive === 0 || item.isActive === false) {
          statusBadge.className = 'badge badge-warning';
          statusBadge.textContent = window.__t('event.statusHidden');
        } else {
          statusBadge.className = 'badge badge-success';
          statusBadge.textContent = txtActive;
        }
        badgeRow.appendChild(statusBadge);

        const dateText = formatEventDates(item.startDate, item.endDate, window.__getLang());
        if (dateText) {
          const dateBadge = document.createElement('span');
          dateBadge.className = 'badge badge-neutral';
          dateBadge.textContent = dateText;
          badgeRow.appendChild(dateBadge);
        }
        card.appendChild(badgeRow);

        const titleEl = document.createElement('h2');
        titleEl.style.fontSize = 'var(--text-lg)';
        titleEl.style.fontWeight = '700';
        titleEl.style.marginBottom = 'var(--space-2)';
        titleEl.style.color = 'var(--ink)';
        titleEl.style.lineHeight = '1.3';
        titleEl.textContent = item.title || '';
        card.appendChild(titleEl);

        const host = item.organizationId && hosts[item.organizationId];
        if (host) {
          const hostEl = document.createElement('p');
          hostEl.style.color = 'var(--muted)';
          hostEl.style.fontSize = 'var(--text-sm)';
          hostEl.style.marginBottom = 'var(--space-2)';
          hostEl.textContent = window.__t('event.hostedBy', { name: host });
          card.appendChild(hostEl);
        }

        const descEl = document.createElement('p');
        descEl.style.color = 'var(--muted)';
        descEl.style.fontSize = 'var(--text-base)';
        descEl.style.flexGrow = '1';
        descEl.style.marginBottom = 'var(--space-4)';
        descEl.style.lineHeight = '1.5';
        descEl.textContent = item.description || '';
        card.appendChild(descEl);

        const footRow = document.createElement('div');
        footRow.style.borderTop = '1px solid var(--line)';
        footRow.style.paddingTop = 'var(--space-3)';
        footRow.style.display = 'flex';
        footRow.style.alignItems = 'center';
        footRow.style.justifyContent = 'flex-end';
        footRow.style.gap = 'var(--space-2)';
        footRow.style.flexWrap = 'wrap';

        if (canManageDraw(viewer, item)) {
          const count = document.createElement('span');
          count.style.marginRight = 'auto';
          count.style.color = 'var(--muted)';
          count.style.fontSize = 'var(--text-sm)';
          count.textContent = `${window.__t('admin.participantCount')}: ${item.participantCount ?? 0}`;
          footRow.appendChild(count);
          for (const [page, key, kind] of [['scanner', 'admin.scan', 'btn-secondary'], ['edit', 'admin.manage', 'btn-secondary']]) {
            const tool = document.createElement('a');
            tool.href = `${detailBaseUrl}/${encodeURIComponent(item.id)}/${page}`;
            tool.className = `btn ${kind} btn-sm`;
            tool.textContent = window.__t(key);
            footRow.appendChild(tool);
          }
        }

        const btn = document.createElement('a');
        btn.href = `${detailBaseUrl}/${encodeURIComponent(item.id)}`;
        btn.className = 'btn btn-primary btn-sm';
        btn.textContent = txtViewDetails;
        footRow.appendChild(btn);

        card.appendChild(footRow);
        gridEl.appendChild(card);
      });

      if (emptyEl) emptyEl.style.display = 'none';
      gridEl.style.display = 'grid';
    }

    /** The draws this visitor runs in this region, public or not, with their entrant counts; [] for anyone else. */
    async function runDraws() {
      if (!viewer || !(viewer.isStaff || drawOrgs(viewer).length)) return [];
      const res = await fetch('/event/api/admin/events');
      const data = await res.json().catch(() => ({}));
      return res.ok && Array.isArray(data.events) ? data.events.filter((e) => e.regionCode === regionCode) : [];
    }

    async function loadEvents() {
      const loadingEl = document.getElementById('events-loading');
      const emptyEl = document.getElementById('events-empty');

      try {
        // Asked without sending anyone to sign in: the list is public.
        const [who, publicRes] = await Promise.all([
          window.__eventWho().catch(() => ({})),
          fetch(`/event/api/events?region=${encodeURIComponent(regionCode)}`),
        ]);
        viewer = who.user ?? null;
        if (startsDraws(viewer, regionCode)) document.getElementById('draw-new-btn').style.display = 'inline-flex';
        const data = await publicRes.json();
        if (!publicRes.ok || !data.success || !Array.isArray(data.events)) throw new Error('events');
        // The public draws, with the ones this visitor runs in their place and added, newest first.
        const own = await runDraws().catch(() => []);
        const byId = new Map(data.events.map((e) => [e.id, e]));
        for (const e of own) byId.set(e.id, e);
        const list = [...byId.values()].sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)));
        hosts = await hostNames(list.map((e) => e.organizationId));

        if (loadingEl) loadingEl.style.display = 'none';

        if (list.length === 0) {
          if (emptyEl) emptyEl.style.display = 'block';
          return;
        }

        cachedEvents = list;
        renderEventGrid(cachedEvents);
      } catch (err) {
        if (loadingEl) loadingEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'block';
      }
    }

    window.addEventListener('ub-lang-changed', async () => {
      if (!cachedEvents) return;
      hosts = await hostNames(cachedEvents.map((e) => e.organizationId));
      renderEventGrid(cachedEvents);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadEvents);
    } else {
      loadEvents();
    }
  </script>
</BaseLayout>
