{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unibooks-event",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // This system's own database: events, prizes and draws. Nothing here reads
  // the main site's tables.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unibooks-event",
      "migrations_dir": "migrations"
    }
  ],
  // This system's own images (events, prizes). Apart from the main site's bucket.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "unibooks-event-assets" }],
  // The bucket's public custom domain, as the main site's R2_PUBLIC_URL: images
  // are read from there, cached by the CDN, without a Worker request. `astro dev`
  // ignores it and serves the local simulator's images under /event/media/.
  "vars": {
    "R2_PUBLIC_URL": "https://event-assets.unibooks.app"
  },
  // The main site, asked who is signed in and whose member pass was scanned.
  // It holds the keys; this Worker has no secrets.
  "services": [{ "binding": "MAIN", "service": "unibooks" }],
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
